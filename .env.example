# Docker Compose environment for the whole stack.
#
# This file is OPTIONAL. `docker compose up --build` works on a fresh clone with
# no .env at all — every variable below has a working local default baked into
# docker-compose.yml. Copy it only when you want to override something:
#
#   cp .env.example .env
#
# The one thing you almost certainly do want to set is your Plaid credentials.
#
# Note: this configures the *containers*. Running finbot-api directly on your
# machine instead? Use finbot-api/.env.example.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=finbot
POSTGRES_PASSWORD=finbot
POSTGRES_DB=finbot
# Host port. Change this if something already owns 5432 locally.
DB_PORT=5432

# --- API (finbot-api) -------------------------------------------------------
# Inside the compose network the database host is the service name, "db".
DATABASE_URL=postgres://finbot:finbot@db:5432/finbot
API_PORT=3000
CORS_ORIGIN=http://localhost:8081
# Must match the VECTOR(n) width in finbot-api/src/db/migrations/001-create-schema.sql.
PG_VECTOR_SIZE=768

# --- Auth -------------------------------------------------------------------
# Compose supplies dev defaults for these, so login works out of the box. Set
# real values for anything beyond your own machine.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Seeded test user -------------------------------------------------------
SEED_TEST_DATA=true
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=1234qwer
TEST_USER_ONBOARDING_COMPLETE=false

# --- Plaid ------------------------------------------------------------------
# Required for the bank connection flow. Get them from
# https://dashboard.plaid.com/developers/keys — use the *Sandbox* secret.
# The stack still boots without these; only /plaid/* will fail.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# sandbox | production
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Encrypts Plaid access tokens at rest. Compose falls back to a well-known dev
# key; generate a real one for any shared or deployed environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENC_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
# Optional. Only needed for OAuth institutions in the native app, and each must
# be registered in the Plaid Dashboard first. Sandbox does not need them.
# PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
# PLAID_ANDROID_PACKAGE_NAME=com.finbotpbd.finbot
# Where Hosted Link sends the browser when the web flow finishes.
# Defaults to CORS_ORIGIN.
# PLAID_HOSTED_LINK_REDIRECT_URI=http://localhost:8081

# --- Web (finbot / Expo) ----------------------------------------------------
WEB_PORT=8081
# Where the Expo bundle looks for the API. Defaults to http://localhost:$API_PORT.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
#
# Hostname Metro advertises to the client. `localhost` is right for browser
# development. Set your machine's LAN IP to attach a physical device or an
# emulator to the Metro bundler.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.50

# --- Ollama (optional, `--profile llm`) -------------------------------------
# OLLAMA_PORT=11434
# OLLAMA_MODEL=tinyllama
# OLLAMA_URL=http://ollama:11434
