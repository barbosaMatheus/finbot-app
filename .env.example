# Docker Compose environment for the whole stack.
#
# Optional: `docker compose up --build` works on a fresh clone with no .env at
# all. Every variable has a working local default in docker-compose.yml, so
# copy this file only to change something:
#
#   cp .env.example .env
#
# Commented lines show the default; uncomment one to override it. This file
# configures the containers. To run finbot-api directly on your machine, see
# finbot-api/.env.example instead.

# --- Plaid (the one thing you will set) -------------------------------------
# https://dashboard.plaid.com/developers/keys — use the Sandbox secret.
# The stack boots without these; only the bank connection fails.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
# PLAID_ENV=sandbox
# Plaid cannot reach localhost. To receive webhooks, run a tunnel
# (`ngrok http 3000`) and register <tunnel-url>/plaid/webhook. Without one the
# worker's polling still completes every sync, just later.
# PLAID_WEBHOOK_URL=https://your-tunnel.example/plaid/webhook
# Set to false only when simulating unsigned webhook deliveries locally.
# PLAID_WEBHOOK_VERIFY=true
# OAuth institutions in the native app only; register each in the Plaid
# dashboard first. Sandbox does not need them.
# PLAID_REDIRECT_URI=https://your-domain.example/plaid/oauth
# PLAID_ANDROID_PACKAGE_NAME=com.finbotpbd.finbot

# --- Gameplan narration (model host) ----------------------------------------
# template (default: no model, plain sentences) | ollama | anthropic.
# Every number the model writes is checked against its input; a narration
# with a number that is not there falls back to the template.
# LLM_PROVIDER=template
# Ollama starts under `docker compose --profile llm up` and pulls OLLAMA_MODEL
# on first start. tinyllama is fast and weak; llama3.1 is about 5 GB.
# OLLAMA_MODEL=tinyllama
# Host port for Ollama; change it if an Ollama installed on the host owns it.
# OLLAMA_PORT=11434
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# LLM_TIMEOUT_MS=20000

# --- Ports (change only on a collision) -------------------------------------
# DB_PORT=5432
# API_PORT=3000
# WEB_PORT=8081

# --- A phone or emulator on your network ------------------------------------
# Metro advertises this hostname to the client, and the bundle looks for the
# API at EXPO_PUBLIC_API_BASE_URL. Both default to localhost, right for a
# browser. Set your machine's LAN IP for a device.
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.50
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000
# CORS_ORIGIN=http://localhost:8081

# --- Secrets (dev defaults are fine on your laptop; set real ones anywhere shared)
# JWT_ACCESS_SECRET=dev-only-access-secret-change-me
# JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
# Encrypts Plaid access tokens at rest. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# PLAID_TOKEN_ENC_KEY=

# --- Seeded test user -------------------------------------------------------
# SEED_TEST_DATA=true
# TEST_USER_EMAIL=user@test.com
# TEST_USER_PASSWORD=1234qwer
# TEST_USER_ONBOARDING_COMPLETE=false

# --- Rarely changed ---------------------------------------------------------
# Postgres credentials; DATABASE_URL must match if you change them.
# POSTGRES_USER=finbot
# POSTGRES_PASSWORD=finbot
# POSTGRES_DB=finbot
# DATABASE_URL=postgres://finbot:finbot@db:5432/finbot
# Must match VECTOR(n) in finbot-api/src/db/migrations/001-create-schema.sql.
# PG_VECTOR_SIZE=768
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# PLAID_PRODUCTS=transactions
# PLAID_COUNTRY_CODES=US
# Days of history requested at link time.
# PLAID_TRANSACTION_DAYS=730
# PLAID_SYNC_POLL_SECONDS=30
# PLAID_SYNC_POLL_TIMEOUT_SECONDS=1800
# The review-ready push is sent only when analysis outlasts this; 0 forces it.
# ANALYSIS_EXPECTED_WINDOW_SECONDS=120
# PGBOSS_SCHEMA=pgboss
# Where Hosted Link sends the browser when the web flow finishes (defaults to CORS_ORIGIN).
# PLAID_HOSTED_LINK_REDIRECT_URI=http://localhost:8081
# ANTHROPIC_EFFORT=low
# OLLAMA_URL=http://ollama:11434
