# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- Postgres ---
POSTGRES_USER=finbot
POSTGRES_PASSWORD=finbot
POSTGRES_DB=finbot
DB_PORT=5432
SEED_TEST_DATA=true

# --- API (finbot-api) ---
# Host reachable from inside the compose network uses the service name "db".
DATABASE_URL=postgres://finbot:finbot@db:5432/finbot
API_PORT=3000
CORS_ORIGIN=http://localhost:8081

# --- Web (finbot / Expo) ---
WEB_PORT=8081

# auth
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=1234qwer
TEST_USER_ONBOARDING_COMPLETE=false

# Set to your machine's LAN IP only if connecting a physical device / emulator
# to the Metro bundler. Leave blank for browser-based web development.
REACT_NATIVE_PACKAGER_HOSTNAME=
