# Expo inlines any EXPO_PUBLIC_* variable into the bundle at build time.
# Copy to .env for local (non-Docker) development:
#
#   cp .env.example .env
#
# Under Docker Compose this is set for you from the repo root .env — see ../DOCKER.md.

# Where the app looks for finbot-api.
#
# - Desktop browser or iOS simulator: http://localhost:3000
# - Android emulator:                 http://10.0.2.2:3000
# - Physical device (dev build):      http://<your-machine-LAN-IP>:3000
#
# A physical device cannot reach "localhost" — that resolves to the phone
# itself. Set your LAN IP here before running `npx expo run:ios|run:android`.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
